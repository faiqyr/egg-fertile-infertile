# ── Python ────────────────────────────────────────
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environment ───────────────────────────
venv/
env/
ENV/
.env
.venv

# ── Model Weights ─────────────────────────────────
*.pt
*.pth
*.h5
*.pkl
*.onnx
*.torchscript

# ── Dataset Folders ───────────────────────────────
train/
valid/
test/
data/
datasets/

# ── Training Runs (contains local paths + images) ─
runs/

# ── Image files (dataset/training images) ─────────
# Block images at root and common locations,
# but allow frontend source assets explicitly.
*.jpg
*.jpeg
*.bmp
*.tiff
*.webp

# Block PNG everywhere except frontend/src/assets/
*.png
!frontend/src/assets/*.png
!frontend/public/*.png

# ── Node.js ───────────────────────────────────────
node_modules/
frontend/dist/
frontend/build/

# ── IDE ───────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Jupyter ───────────────────────────────────────
.ipynb_checkpoints/

# ── Logs ──────────────────────────────────────────
*.log
logs/
